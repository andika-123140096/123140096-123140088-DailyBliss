CREATE TABLE MomentEntity (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    title TEXT NOT NULL,
    content TEXT NOT NULL,
    media_url TEXT,
    mood TEXT,
    tags TEXT,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

CREATE TABLE NewsCache (
    key TEXT PRIMARY KEY,
    data_ TEXT NOT NULL,
    updated_at INTEGER NOT NULL
);

-- Moment Queries --
getAllMoments:
SELECT * FROM MomentEntity
ORDER BY updated_at DESC;

searchMoments:
SELECT * FROM MomentEntity
WHERE title LIKE '%' || ? || '%' OR content LIKE '%' || ? || '%'
ORDER BY updated_at DESC;

getMomentById:
SELECT * FROM MomentEntity
WHERE id = ?;

getMomentsFromSameDay:
SELECT * FROM MomentEntity
WHERE strftime('%m-%d', datetime(created_at / 1000, 'unixepoch')) = ?
AND strftime('%Y', datetime(created_at / 1000, 'unixepoch')) < strftime('%Y', 'now')
ORDER BY created_at DESC;

getMomentsByDateRange:
SELECT * FROM MomentEntity
WHERE created_at >= ? AND created_at < ?
ORDER BY created_at DESC;

insertMoment:
INSERT INTO MomentEntity (title, content, media_url, mood, tags, created_at, updated_at)
VALUES (?, ?, ?, ?, ?, ?, ?);

lastInsertId:
SELECT last_insert_rowid();

updateMoment:
UPDATE MomentEntity
SET title = ?, content = ?, media_url = ?, mood = ?, tags = ?, updated_at = ?
WHERE id = ?;

deleteMoment:
DELETE FROM MomentEntity
WHERE id = ?;

deleteMomentsByIds:
DELETE FROM MomentEntity
WHERE id IN ?;

countMoments:
SELECT COUNT(*) FROM MomentEntity;

-- Cache Queries --
getCache:
SELECT * FROM NewsCache WHERE key = ?;

insertCache:
INSERT OR REPLACE INTO NewsCache (key, data_, updated_at)
VALUES (?, ?, ?);

deleteCache:
DELETE FROM NewsCache WHERE key = ?;
